NODE_ENV=development
PORT=8080
DB_HOST=database-1.c3oq6oqssh7j.ap-southeast-2.rds.amazonaws.com
DB_PORT=3306
DB_NAME=ecommerce_platform
DB_USER=admin
DB_PASSWORD=your_mysql_password
DB_DIALECT=mysql
DB_LOGGING=true

ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret

# Cloudinary Config
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret

# Email Configuration (Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_email_app_password
MAIL_FROM_NAME="MeeMart CSKH"

# VNPay Configuration
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000

# Vector Search Configuration
# Option 1: "ram" (Nạp trực tiếp ma trận vector lên RAM của backend)
# Option 2: "microservice" (Gọi sang Vector AI Microservice chạy độc lập sử dụng trực tiếp model)
VECTOR_SEARCH_MODE=ram
VECTOR_SERVICE_URL=http://localhost:8095
VECTOR_FALLBACK_RAM=true
# Thời gian chờ tối đa khi gọi Vector Microservice (Reranker trên CPU cần nhiều thời gian hơn)
VECTOR_SERVICE_TIMEOUT_MS=30000

