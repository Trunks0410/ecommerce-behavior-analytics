# ==============================================================================
# UNIFIED PRODUCTION ENV TEMPLATE (Copy thành .env trên EC2 và điền giá trị thật)
# Tuyệt đối KHÔNG commit file .env chứa secret thật lên Git!
# ==============================================================================

# --- Docker & Deployment ---
IMAGE_TAG=latest
NODE_ENV=production

# --- Database (MySQL 8.0) ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ecommerce_db
SHIPMENT_DB_NAME=ecommerce_db
DB_USER=root
DB_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DB_DIALECT=mysql
DB_LOGGING=false

# --- Analytics & Search Microservice ---
VECTOR_DIM=2048
SEARCH_MODE=ram
ENABLE_RERANK=true
MODEL_INFERENCE_URL=
MODEL_INFERENCE_TIMEOUT_MS=45000
MODEL_IMAGE_TIMEOUT_MS=60000
ANALYTICS_SERVICE_TIMEOUT_MS=60000
REC_TIME_DECAY_LAMBDA=0.03

# --- JWT & Auth ---
ACCESS_TOKEN_SECRET=CHANGE_ME_ACCESS_TOKEN_SECRET
REFRESH_TOKEN_SECRET=CHANGE_ME_REFRESH_TOKEN_SECRET
SHIPMENT_ACCESS_TOKEN_SECRET=CHANGE_ME_SHIPMENT_ACCESS_TOKEN_SECRET_MIN_32_CHARS
SHIPMENT_REFRESH_TOKEN_SECRET=CHANGE_ME_SHIPMENT_REFRESH_TOKEN_SECRET_MIN_32_CHARS

# --- CORS (thêm domain/sslip.io của EC2, ngăn cách bởi dấu phẩy) ---
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Cross-Service API Keys ---
UTE_SHIPMENT_SERVICE_API_KEY=CHANGE_ME_SHARED_SHIPMENT_KEY
ECOMMERCE_SERVICE_API_KEY=CHANGE_ME_SHARED_SHIPMENT_KEY

# --- Cloudinary ---
CLOUDINARY_NAME=CHANGE_ME
CLOUDINARY_KEY=CHANGE_ME
CLOUDINARY_SECRET=CHANGE_ME

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=CHANGE_ME
MAIL_PASS=CHANGE_ME
MAIL_FROM_NAME=MeeMart

# --- VNPay ---
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=CHANGE_ME
VNPAY_HASH_SECRET=CHANGE_ME
VNPAY_RETURN_URL=http://YOUR_EC2_DOMAIN/payment/vnpay-return

# --- Google reCAPTCHA & Gemini ---
RECAPTCHA_SECRET_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
